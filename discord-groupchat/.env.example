# --- Discord bot tokens (Developer Portal > 各アプリ > Bot > Reset Token) ---
# 3体ぶん。オーケストレーター用のみ MESSAGE CONTENT INTENT を ON にすること。
DISCORD_ORCH_TOKEN=
DISCORD_CLAUDE_TOKEN=
DISCORD_GEMINI_TOKEN=

# --- Gemini API key（無料枠）---
# https://aistudio.google.com/apikey で AIzaSy... を発行（課金なしの無料枠でOK）
GEMINI_API_KEY=

# Claude担当は `claude` CLI（Claude Code のサブスク）を使うため APIキー不要。
# claude が PATH に無い場合のみ絶対パスを指定:
# CLAUDE_BIN=claude

# --- Optional ---
# GEMINI_MODEL=gemini-2.5-flash
# MAX_TURNS=6          # 1回の !talk での合計発言数
