# --- LINE channel credentials (LINE Developers console > Messaging API) ---
LINE_CHANNEL_ACCESS_TOKEN=your-long-lived-channel-access-token
LINE_CHANNEL_SECRET=your-channel-secret

# --- Access control ---
# Comma-separated LINE user IDs allowed to use the bot. Only these users get a
# reply; everyone else is ignored. Find your own ID from a webhook event's
# source.userId (visible in the server logs the first time you message the bot).
ALLOWED_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional ---
# PORT=3000
# CLAUDE_BIN=claude              # path to the claude CLI if not on PATH
# COMMAND_TIMEOUT_MS=120000      # kill the command after this many ms
