# --- LINE channel credentials (LINE Developers console > Messaging API) ---
LINE_CHANNEL_ACCESS_TOKEN=your-long-lived-channel-access-token
LINE_CHANNEL_SECRET=your-channel-secret

# --- Access control ---
# Comma-separated LINE user IDs allowed to use the bot. Only these users get a
# reply; everyone else is ignored.
ALLOWED_USER_IDS=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Public URL for sending generated media back to LINE ---
# LINE can only send media from a public HTTPS URL. Set this to the base URL
# LINE reaches your server on (same host as your webhook). Generated files are
# served at <PUBLIC_BASE_URL>/media/... . If unset, replies are text-only.
PUBLIC_BASE_URL=https://your-domain.example.com

# --- Optional ---
# PORT=3000
# CLAUDE_BIN=claude              # path to the claude CLI if not on PATH
# CLAUDE_ARGS=-p                 # args before the prompt; -p = headless print mode (required)
# COMMAND_TIMEOUT_MS=300000      # kill the command after this many ms
# WORK_DIR=./workspace           # claude's working dir; scanned for new media
# INBOUND_DIR=./inbound          # where images/videos you send are saved
# MEDIA_SERVE_DIR=./public-media # generated media copied here for serving
