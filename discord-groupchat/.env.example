# --- Discord bot tokens (Developer Portal > 各アプリ > Bot > Reset Token) ---
# 3体ぶん。オーケストレーター用のみ MESSAGE CONTENT INTENT を ON にすること。
DISCORD_ORCH_TOKEN=
DISCORD_CLAUDE_TOKEN=
DISCORD_GEMINI_TOKEN=

# --- Gemini API key（無料枠）---
# https://aistudio.google.com/apikey で AIzaSy... を発行（課金なしの無料枠でOK）
GEMINI_API_KEY=

# Claude担当は `claude` CLI（Claude Code のサブスク）を使うため APIキー不要。
# claude が PATH に無い場合のみ絶対パスを指定:
# CLAUDE_BIN=claude

# --- Higgsfield API（映像制作パイプライン用）---
# cloud.higgsfield.ai/api-keys で発行。キーは「ID + シークレット」のペア。
HIGGSFIELD_API_KEY=              # KEY ID
HIGGSFIELD_API_SECRET=          # KEY SECRET
# 生成モデル(app)を変えたいとき:
# HIGGSFIELD_IMAGE_APP=bytedance/seedream/v4/text-to-image
# HIGGSFIELD_VIDEO_APP=higgsfield/dop-turbo/image2video

# --- YouTube急上昇の自動リサーチ（毎日） ---
# Google Cloud Console で「YouTube Data API v3」を有効化してAPIキーを発行（無料）
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# 毎日のレポートを投稿するDiscordチャンネルのID（チャンネルを右クリック→IDをコピー）
TREND_CHANNEL_ID=
# TREND_HOUR=8           # 実行時刻（JST・毎日）
# TREND_REGION=JP        # 急上昇のリージョン
# TREND_DEEP_COUNT=5     # 1日に実際に「視聴」する本数（無料枠と相談して増減）
# TREND_MAX_MINUTES=20   # これより長い動画は視聴対象外

# --- Optional ---
# GEMINI_MODEL=gemini-2.5-flash
# MAX_TURNS=6          # 1回の !talk での合計発言数
# CASUAL_LEAD=claude   # 軽い雑談の担当。claude=Gemini枠温存(5〜20秒) / gemini=高速応答(1〜3秒・枠消費)
# CLAUDE_TIMEOUT=300   # claude CLI のタイムアウト秒
# CLAUDE_CONCURRENCY=2 # claude CLI の同時実行数
