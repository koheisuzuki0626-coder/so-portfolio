# --- Discord bot tokens (Developer Portal > 各アプリ > Bot > Reset Token) ---
# 3体ぶん。オーケストレーター用のみ MESSAGE CONTENT INTENT を ON にすること。
DISCORD_ORCH_TOKEN=
DISCORD_CLAUDE_TOKEN=
DISCORD_GEMINI_TOKEN=

# --- AI API keys ---
# Claude API（従量課金）: https://console.anthropic.com/ でキー発行＋クレジット必要
ANTHROPIC_API_KEY=
# Gemini API（無料枠あり）: https://aistudio.google.com/apikey で AIzaSy... を発行
GEMINI_API_KEY=

# --- Optional ---
# CLAUDE_MODEL=claude-sonnet-5
# GEMINI_MODEL=gemini-2.5-flash
# MAX_TURNS=6          # 1回の !talk での合計発言数
