{
  "name": "line-claude-webhook",
  "version": "1.0.0",
  "description": "LINE Messaging API webhook that runs received text through the Claude Code CLI and replies with the output",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js"
  },
  "engines": {
    "node": ">=20.18"
  },
  "dependencies": {
    "@line/bot-sdk": "^9.5.0",
    "express": "^4.21.2"
  }
}
